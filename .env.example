# Copy this file to .env and fill in the values.

# ---- Flask ----
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///dnd.db
ALLOWED_ORIGINS=http://localhost:5000

# ---- Gemini ----
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model selection. Flash for every turn; Pro reserved for campaign-init
# and context compaction (heavier thinking, called rarely).
GEMINI_NARRATION_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-pro

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=1800

# ---- Game tuning ----
# How many turns to keep verbatim before compacting into a memoir entry.
TURNS_BEFORE_COMPACTION=12
# Target char length per compacted memoir entry.
MEMOIR_TARGET_CHARS=1200
SOCKETIO_ASYNC_MODE=gevent
